# Copie este arquivo pra ".env" (não commitado) e preencha os valores reais.
# Sem nada configurado, o jogo funciona normalmente com os elencos estáticos (offline).

# RECOMENDADO: URL do proxy (Cloudflare Worker, ver worker/football-proxy.js) — resolve
# o bloqueio de CORS da football-data.org e mantém sua chave fora do bundle público.
# Exemplo depois do deploy: https://footplan-football-proxy.SEU-USUARIO.workers.dev
VITE_FOOTBALL_PROXY_URL=

# Alternativa (sem proxy): chave direta da API football-data.org. Só funciona se a sua
# conta lá liberar seus domínios de origem nas configurações dela — testado e confirmado
# que por padrão ela bloqueia chamadas direto do navegador (CORS). Prefira o proxy acima.
VITE_FOOTBALL_API_KEY=

# Supabase — cloud save (Modo Carreira). Sem isso, o save continua
# funcionando normalmente em localStorage, sem sincronização cross-device.
# Crie um projeto gratuito em https://supabase.com e pegue a URL e anon key
# em Settings > Data API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ADMIN (só no .env local / NUNCA com prefixo VITE_ — não vai pro bundle do browser):
# service role key do Supabase, usada pelo `npm run rosters:sync` pra publicar o
# snapshot global de elencos. O RLS de produção fecha write pra anon/authenticated.
# Pegue em Settings > Data API > service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# PeerServer próprio pro multiplayer (opcional — sem isso usa o broker público da
# PeerJS, sem SLA). Ver GUIA_PRODUCAO.md pra subir o seu.
VITE_PEER_HOST=
VITE_PEER_PORT=443
VITE_PEER_PATH=/
VITE_PEER_SECURE=true
